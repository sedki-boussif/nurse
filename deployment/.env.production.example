# ========================================
# Production Environment Configuration
# Copy this file to .env and fill in the values
# ========================================

# Django Settings
# Generate a new secret key using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-key-here-change-this

# Set to False in production
DEBUG=False

# Add your domain and IP addresses (comma-separated, no spaces)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your_vps_ip

# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://theses_user:your_db_password@localhost:5432/theses_db

# CORS Settings (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CSRF Settings (comma-separated, no spaces)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# AWS S3 Settings (Optional - for media storage)
# USE_S3=False
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_S3_REGION_NAME=us-east-1

# Sentry Configuration (Optional - for error tracking)
# SENTRY_DSN=your_sentry_dsn_here

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://localhost:6379/0
